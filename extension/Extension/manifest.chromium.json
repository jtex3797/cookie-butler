{
	"name": "쿠키 도우미",
	"description": "쿠키 동의 창을 대신 처리 (Consent-O-Matic 기반)",
	"author": "Consent-O-Matic (CAVI - Aarhus University) 기반 개조",
	"version": "REPLACED_BY_BUILD_SCRIPT",
	"manifest_version": 3,
	"permissions": [
		"activeTab",
		"tabs",
		"storage",
		"cookies"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"action": {
		"default_title": "쿠키 도우미",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icon_16.png",
			"32": "icon_32.png"
		}
	},
	"background": {
		"service_worker": "service.js"
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"content.js"
			],
			"css": [
				"content.css"
			],
			"all_frames": true,
			"match_about_blank": true,
			"run_at": "document_start"
		}
	],
	"icons": {
		"16": "icon_16.png",
		"32": "icon_32.png",
		"48": "icon_48.png",
		"96": "icon_96.png",
		"128": "icon_128.png"
	}
}