{
	"name": "Cookie Butler",
	"description": "쿠키 동의 창을 정해 둔 범위대로 대신 처리합니다. 필수만, 기능까지, 통계까지, 전부 허용 중 선택.",
	"author": "Consent-O-Matic (CAVI - Aarhus University) 기반 개조",
	"version": "REPLACED_BY_BUILD_SCRIPT",
	"manifest_version": 3,
	"permissions": [
		"storage",
		"cookies",
		"scripting"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"action": {
		"default_title": "Cookie Butler",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icon_16.png",
			"32": "icon_32.png"
		}
	},
	"background": {
		"service_worker": "service.js"
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"content.js"
			],
			"css": [
				"content.css"
			],
			"all_frames": true,
			"match_about_blank": true,
			"run_at": "document_start"
		}
	],
	"icons": {
		"16": "icon_16.png",
		"32": "icon_32.png",
		"48": "icon_48.png",
		"96": "icon_96.png",
		"128": "icon_128.png"
	}
}